{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "biai-dealflow": {
      "root": "frontend/",
      "framework": "other",
      "outputDirectory": "."
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.app.main:app",
      "functions": {
        "backend/app/main.py": {
          "includeFiles": "sample-data/intern/task2-corporate-leads/corporate-leads.csv"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "biai-dealflow"
      }
    }
  ]
}
